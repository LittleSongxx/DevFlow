# DevFlow AI 配置模板：复制为 .env 后填写。
# 带随机要求的项（POSTGRES_PASSWORD / TOKEN_ENCRYPTION_KEY / GITHUB_WEBHOOK_SECRET / DEVFLOW_API_KEY）
# 请用 `openssl rand -hex 16` 生成，不要使用示例占位值。

APP_ENV=development
APP_NAME=DevFlow AI
API_HOST=0.0.0.0
API_PORT=8000
# 前端默认跑在 3001（3000 常被占用）
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000

# ---- 数据库 ----
POSTGRES_USER=devflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devflow
# 宿主机直连用；docker compose 内的后端会自动改用 postgres 服务名
DATABASE_URL=postgresql+psycopg://devflow:change-me@localhost:5433/devflow

# ---- 服务访问鉴权：设置后所有 /api/* 请求须带 X-API-Key 头（webhook 与 /health 豁免）----
DEVFLOW_API_KEY=

# ---- LLM（OpenAI 兼容；默认 DeepSeek）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
# RAG 问答是否允许调用 LLM 生成
RAG_LLM_ENABLED=true

# ---- GitHub ----
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
# github_compatible 自建服务需把主机加入白名单（防 SSRF/全局凭证外泄）
GITHUB_API_ALLOWED_HOSTS=api.github.com
GITHUB_CLONE_ALLOWED_HOSTS=github.com,www.github.com
# 本地仓库模式：允许注册位于 $HOME 或工作区内的本地 git 仓库
ALLOW_LOCAL_REPO_MODE=true

# ---- Embedding / Rerank ----
# 可选 provider: qwen_local（本地模型，需 requirements-local-embedding.txt）
#              dashscope（百炼 API，推荐）
#              openai_compatible（任意 /v1/embeddings 服务）
#              deterministic（仅演示/测试）
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LOCAL_EMBEDDING_DEVICE=
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANK_API_KEY=
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_RERANK_MODEL=qwen3-rerank

# ---- 向量检索（pgvector，随 PostgreSQL 部署）----
VECTOR_SEARCH_ENABLED=true
RAG_RERANK_TOP_N=24

# ---- 凭证加密 / Webhook / 演示模式 ----
TOKEN_ENCRYPTION_KEY=change-me
GITHUB_WEBHOOK_SECRET=
DEMO_MODE=false

# ---- Ragas 评测（Judge 留空则复用 LLM_* 配置）----
RAGAS_ENABLED=true
RAGAS_JUDGE_API_KEY=
RAGAS_JUDGE_BASE_URL=
RAGAS_JUDGE_MODEL=
RAGAS_TIMEOUT_SECONDS=120
RAGAS_JUDGE_MAX_TOKENS=8192
RAGAS_ANSWER_RELEVANCY_STRICTNESS=1
RAGAS_MAX_CASES=5
RAGAS_CONTEXT_PRECISION_MIN=0.75
RAGAS_CONTEXT_RECALL_MIN=0.80
RAGAS_FAITHFULNESS_MIN=0.90
RAGAS_ANSWER_RELEVANCY_MIN=0.80
RAGAS_AGENT_GOAL_ACCURACY_MIN=0.80
RAGAS_TOOL_CALL_ACCURACY_MIN=0.90
RAGAS_TOOL_CALL_F1_MIN=0.90

# ---- 上下文管理 ----
CONTEXT_MAX_INPUT_TOKENS=24000
CONTEXT_RESERVED_RESPONSE_TOKENS=3000
CONTEXT_DYNAMIC_MODEL_WINDOW_ENABLED=true
CONTEXT_MODEL_WINDOW_TOKENS=0
CONTEXT_COMPACT_RESERVED_OUTPUT_TOKENS=12000
CONTEXT_AUTO_COMPACT_ENABLED=true
CONTEXT_WARNING_BUFFER_TOKENS=20000
CONTEXT_AUTO_COMPACT_BUFFER_TOKENS=13000
CONTEXT_AGGRESSIVE_BUFFER_TOKENS=8000
CONTEXT_MANUAL_BUFFER_TOKENS=3000
CONTEXT_MAX_COMPACTION_FAILURES=3
CONTEXT_MICROCOMPACT_KEEP_RECENT_MESSAGES=8
CONTEXT_COMPACT_KEEP_RECENT_MESSAGES=8
CONTEXT_COMPACT_SUMMARY_TOKENS=1800
CONTEXT_SYSTEM_RATIO=0.12
CONTEXT_MEMORY_RATIO=0.22
CONTEXT_EVIDENCE_RATIO=0.34
CONTEXT_RECENT_RATIO=0.22
CONTEXT_TOOL_RATIO=0.10
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_KEY=devflow-agent-v1
PROMPT_CACHE_RETENTION=

# ---- 工作流 / 存储 / 同步 ----
WORKFLOW_TASK_TIMEOUT_SECONDS=90
REPO_CHECKOUT_DIR=.data/repos
UPLOAD_DIR=.data/uploads
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_SECONDS=300
AUTO_SYNC_LIMIT=50

# ---- 前端 ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- 可选：负反馈飞书通知 ----
FEISHU_FEEDBACK_WEBHOOK_URL=
FEEDBACK_TRACE_BASE_URL=http://localhost:8000
