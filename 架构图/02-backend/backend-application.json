  "cards": [
    {
      "dot": "cyan",
      "title": "请求管道",
      "items": [
        "ApiKeyMiddleware 保护全部 /api/*：X-API-Key 或 Bearer 头，hmac.compare_digest 比较",
        "FastAPI lifespan 启动时自动建表（advisory lock 防并发）、清扫遗留后台任务、启动周期同步",
        "18 个 Router 按域挂载：repos、conversations、issues、pull_requests、ci、chat、feedback、action_drafts、reports、search、skills、knowledge、project_index、rag、code_graph、evaluations、webhooks、workspaces"
      ]
    },
    {
      "dot": "emerald",
      "title": "领域服务",
      "items": [
        "Agent 服务：ChatAgent（LangGraph 三节点循环）+ WorkflowOrchestrator + Issue/PR/CI/报告/安全/推荐/检索 7 个专项 Agent",
        "RAG 服务：段落感知切片、批量嵌入、向量+BM25 混合检索、qwen3-rerank 重排、answer gate",
        "记忆与上下文：ContextAssembler 预检索、SessionSealer 会话封存、ProgressiveContextManager 渐进压缩，记忆工具经 MCP 子进程提供"
      ]
    },
    {
      "dot": "amber",
      "title": "基础设施客户端",
      "items": [
        "LLM 客户端封装 OpenAI 兼容接口，chat_json + Pydantic 校验保证结构化输出，失败回退规则实现",
        "GitHub 客户端强制 https + API 主机白名单，全局 token 只发给 api.github.com，重定向时剥离凭证",
        "SQLAlchemy 数据层承载 32 张表与 pgvector 向量列；Alembic 迁移在启动时自动执行（见下图 1）"
      ]
    }
  ]
}