  "cards": [
    {
      "dot": "cyan",
      "title": "仓库域（核心）",
      "items": [
        "repositories：owner/name/full_name 唯一，provider（github / github_compatible）、api_base_url、clone_url、local_path、checkout_mode（managed / local）、加密 token、last_sync_at",
        "project_index_states：每仓一条，项目文档索引状态机（missing / stale / building / ready / failed）与指纹",
        "删除仓库级联清理 30+ 张表（documents 行删除即向量删除）"
      ]
    },
    {
      "dot": "emerald",
      "title": "同步与图谱域",
      "items": [
        "issues / pull_requests / workflow_runs 均带 (repo_id, github_id) 唯一约束，支持 savepoint 并发安全 upsert",
        "pr_files 与 pr_review_comments 挂 pr_id 外键；workflow_runs 的 jobs（含 steps）存 JSON、失败日志存 logs_text",
        "analysis_results 按 (target_type, target_id) 逻辑关联三类分析结果；code_symbols / code_relations 带 branch、commit_sha、pr_id、pr_number 全索引化维度"
      ]
    },
    {
      "dot": "violet",
      "title": "对话与记忆域",
      "items": [
        "chat_messages 带 conversation_id 与 tool_calls JSON；chat_sessions 封存整轮 transcript；agent_runs 记录单次执行轨迹",
        "thread_memories（repo 级）与 conversation_memories（会话级）各存 facts / tasks / preferences / citations 投影",
        "evidence_items 是检索证据缓存；recall_events 审计每次召回与工具调用；memory_candidates 待人工审定的记忆候选"
      ]
    },
    {
      "dot": "amber",
      "title": "RAG / 评测 / 治理域",
      "items": [
        "documents 是切片事实源：文本 + 元数据 + pgvector 向量列（HNSW 余弦索引）同库存储，无独立向量库",
        "eval_runs.result_json 保存指标、逐题轨迹、检索证据与 Markdown 报告",
        "action_drafts.pending_confirmation → executed / failed，写 GitHub 但本地失败仍标 executed 防重复；audit_logs 记录全部敏感操作"
      ]
    }
  ]
}